PORT= 8000

FRONTEND_URL= http://localhost:5173

# Database
DB_NAME= your-database-name
DATABASE_URL= mongodb+srv://<username>:<password>@cluster0.mytnjgr.mongodb.net # your-mongodb-connection-string
DATABASE_URL= mongodb://localhost:27017

# JWT Configuration
JWT_SECRET_KEY= your_jwt_secret_key
JWT_EXPIRES= 1d

# Activation Token Secret Key
ACTIVATION_TOKEN_SECRET_KEY= your_activation_token_secret_key
EXPIRES_ACTIVATION_TOKEN= 5m

# Node Environment
NODE_ENV= DEVELOPMENT

# SMPT Configuration for sending emails
SMPT_HOST= smtp.gmail.com
SMPT_PORT= 587
SMPT_MAIL= your-email@gmail.com  #the email you used to create app password
SMPT_PASSWORD= your-email-password # your generated app password
SMPT_SERVICE= gmail

# Cloudinary (required on Vercel for avatar uploads)
CLOUDINARY_CLOUD_NAME= your-cloudinary-cloud-name
CLOUDINARY_API_KEY= your-api-key
CLOUDINARY_API_SECRET= your-api-secret

# Stripe Configuration
STRIPE_API_KEY=pk_test_your-stripe-public-key
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key